<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="METZ Display" android:icon="@drawable/display_icon" android:banner="@drawable/display_banner" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".CapabilityActivity" android:exported="true" android:theme="@android:style/Theme.NoDisplay" />
        <activity android:name=".ReceiverActivity" android:launchMode="singleTop" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".PairingInfoReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <receiver android:name=".ReceiverStatusReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <receiver android:name=".StreamModesReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <receiver android:name=".SessionRequestReceiver" android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
