<resources>
    <color name="background">#0B1220</color>
    <color name="surface">#111A2B</color>
    <color name="text">#F5F7FA</color>
    <color name="muted">#AEB8C7</color>
    <color name="focus">#2F80FF</color>
    <color name="focus_soft">#7DB5FF</color>
    <style name="HomeTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:colorAccent">@color/focus</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
